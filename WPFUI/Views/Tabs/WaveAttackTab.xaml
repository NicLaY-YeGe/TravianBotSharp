<v:WaveAttackTabBase
    x:Class="WPFUI.Views.Tabs.WaveAttackTab"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFUI.Views.Tabs"
    mc:Ignorable="d"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DesignHeight="650" d:DesignWidth="900">
    <Grid Background="#FFE5E5E5" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source village / target / movement type -->
        <Border Style="{DynamicResource Box}" Grid.Row="0" Padding="10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Source village:" VerticalAlignment="Center" />
                    <ComboBox x:Name="VillageComboBox" Width="180" Margin="10,0,0,0" DisplayMemberPath="VillageName" />

                    <Label Content="Target coordinates:" VerticalAlignment="Center" Margin="30,0,0,0" />
                    <TextBox x:Name="TargetX" materialDesign:HintAssist.Hint="X" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Width="70" Margin="10,0,0,0" />
                    <TextBox x:Name="TargetY" materialDesign:HintAssist.Hint="Y" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Width="70" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Movement type:" VerticalAlignment="Center" />
                    <RadioButton x:Name="AttackNormalRadio" Content="Attack (normal)" GroupName="EventType" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <RadioButton x:Name="AttackRaidRadio" Content="Raid" GroupName="EventType" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <RadioButton x:Name="ReinforcementRadio" Content="Reinforcement" GroupName="EventType" VerticalAlignment="Center" Margin="10,0,0,0" />

                    <Button x:Name="ScheduleButton" Content="Calculate &amp; schedule wave attack" Margin="30,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main (opening) wave: exact troop amounts, hero option, gap-to-next-wave seconds -->
        <Border Style="{DynamicResource Box}" Grid.Row="1" Margin="0,5,0,0" Padding="10">
            <StackPanel Orientation="Vertical">
                <Label Content="Main wave (opening attack)" FontWeight="Bold" />
                <ItemsControl x:Name="MainWaveList" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,4">
                                <Label Content="{Binding TroopName}" Width="120" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Amount, Mode=TwoWay}" Width="70" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <CheckBox x:Name="MainWaveIncludeHeroCheckBox" Content="Send hero with this wave" VerticalAlignment="Center" />
                    <Label Content="Gap before next wave (seconds):" VerticalAlignment="Center" Margin="30,0,0,0" />
                    <TextBox x:Name="GapSeconds" Width="60" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Repeat wave: same small composition sent WaveCount times, GapSeconds apart -->
        <Border Style="{DynamicResource Box}" Grid.Row="2" Margin="0,5,0,0" Padding="10">
            <StackPanel Orientation="Vertical">
                <Label Content="Repeat wave (sent WaveCount times, GapSeconds apart)" FontWeight="Bold" />
                <ItemsControl x:Name="RepeatWaveList" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,4">
                                <Label Content="{Binding TroopName}" Width="120" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Amount, Mode=TwoWay}" Width="70" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                    <Label Content="Wave count (0 = main wave only):" VerticalAlignment="Center" />
                    <TextBox x:Name="WaveCount" Width="60" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</v:WaveAttackTabBase>
