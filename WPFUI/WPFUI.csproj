<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
       <PropertyGroup>
       <PlaywrightPlatform>win</PlaywrightPlatform>
     </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>TravianBotSharp</AssemblyName>
    <SignAssembly>False</SignAssembly>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CP.Extensions.Hosting.ReactiveUI.Wpf" Version="2.2.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="ReactiveUI.Drawing" Version="22.2.1" />
    <PackageReference Include="ReactiveUI.WPF" Version="22.2.1" />    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MainCore\MainCore.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WPFUI.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  
  <!-- 2026-10-21: Playwright'in kendi kurali surucuyu (.playwright klasoru) tek-dosya yayina
       koymadi. Yayindan sonra dogrudan paketten kopyala. Microsoft.Playwright surumu degisirse
       asagidaki 1.60.0'i de degistir. -->
  <Target Name="CopyPlaywrightDriverToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PwNode Include="$(NuGetPackageRoot)microsoft.playwright\1.60.0\.playwright\node\win32_x64\**" />
      <_PwPackage Include="$(NuGetPackageRoot)microsoft.playwright\1.60.0\.playwright\package\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_PwNode)" DestinationFiles="@(_PwNode->'$(PublishDir).playwright\node\win32_x64\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PwPackage)" DestinationFiles="@(_PwPackage->'$(PublishDir).playwright\package\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  </Project>

